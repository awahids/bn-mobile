# Database
DATABASE_URL="mongodb://localhost:27017/hijaiyah-app"

# OAuth Providers
# Google OAuth client ID used by frontend button (Google Identity Services)
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id"

# Google OAuth client ID also required by Go server validation
GOOGLE_CLIENT_ID="your-google-client-id"

# Development
NODE_ENV="development"

# API Configuration
NEXT_PUBLIC_API_BASE_URL="http://localhost:9001/api/v1"
INTERNAL_API_ORIGIN="http://localhost:9001"

# External APIs
PRAYER_TIMES_API_KEY=""

# Bun specific
BUN_ENV="development"
