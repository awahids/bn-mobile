// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  // Note: Prisma v7 will require moving this to prisma.config.ts
  // Current v5.22.0 configuration is correct
  url      = env("DATABASE_URL")
}

// NextAuth.js OAuth Models
model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique @map("session_token")
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

model User {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  username      String?  @unique
  streak        Int      @default(0)
  dailyProgress Int      @default(0) @map("daily_progress")
  lastActive    DateTime @default(now()) @map("last_active")
  preferences   Json     @default("{}")
  
  // OAuth Relations
  accounts      Account[]
  sessions      Session[]
  
  // App Relations
  progress      UserProgress[]
  bookmarks     Bookmark[]
  dhikrCounters DhikrCounter[]
  quizAttempts  QuizAttempt[]
  
  @@map("users")
}

model UserProgress {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  module       String   // 'hijaiyah', 'quran', 'dhikr', 'quiz'
  itemId       String   @map("item_id")
  progress     Int      @default(0) // 0-100
  completed    Boolean  @default(false)
  score        Int      @default(0)
  timeSpent    Int      @default(0) @map("time_spent") // in seconds
  lastAccessed DateTime @default(now()) @map("last_accessed")
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, module])
  @@index([userId, module, itemId])
  @@map("user_progress")
}

model Bookmark {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  type      String   // 'quran', 'dhikr'
  contentId String   @map("content_id")
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, type])
  @@map("bookmarks")
}

model DhikrCounter {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  userId    String  @db.ObjectId
  dhikrId   String  @map("dhikr_id")
  count     Int     @default(0)
  target    Int     @default(33)
  date      String  // YYYY-MM-DD format
  session   String  // 'morning' or 'evening'
  completed Boolean @default(false)
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, date])
  @@index([userId, dhikrId, date, session])
  @@map("dhikr_counters")
}

model QuizAttempt {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @db.ObjectId
  category       String
  score          Int
  totalQuestions Int      @map("total_questions")
  timeSpent      Int      @map("time_spent")
  answers        Json     // array of answer objects
  completedAt    DateTime @default(now()) @map("completed_at")
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, category])
  @@index([userId, completedAt])
  @@map("quiz_attempts")
}