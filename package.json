    "drizzle-zod": "^0.7.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^11.13.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.453.0",
    "next": "^16.1.1",
    "next-auth": "5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "prisma": "5.22.0",
    "react": "^19.2.3",
    "react-day-picker": "^8.10.1",
    "react-dom": "^19.2.3",
