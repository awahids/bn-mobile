{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "bun --bun next dev",
    "dev:bun": "bun --bun next dev",
    "prebuild": "bun prisma generate",
    "build": "bun prisma generate && NODE_ENV=production bun --bun next build",
    "build:bun": "bun run scripts/build-with-bun.ts build",
    "postinstall": "bun prisma generate",
    "start": "bun --bun next start",
    "lint": "bunx eslint .",
    "type-check": "bun tsc --noEmit",
    "clean": "bun run clean:all",
    "clean:all": "rm -rf .next out dist node_modules/.cache",
    "bun:dev": "bun --hot next dev",
    "bun:build": "BUN_RUNTIME=bun NODE_ENV=production bun --bun next build",
    "bun:start": "bun --bun next start",
    "bun:analyze": "ANALYZE=true bun run build",
    "db:push": "bunx drizzle-kit push",
    "db:migrate": "bun run scripts/migrate-data.ts",
    "db:validate": "bun run scripts/migrate-data.ts --validate-only",
    "perf:analyze": "bun run build && bun run scripts/analyze-bundle.ts",
    "perf:lighthouse": "bun lighthouse http://localhost:3000 --output=json --output-path=./lighthouse-report.json",
    "perf:optimize": "bun run scripts/bun-optimize.ts all production",
    "perf:monitor": "bun run scripts/bun-optimize.ts benchmark",
    "perf:clear-cache": "bun run scripts/bun-optimize.ts clear-cache"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.1",
    "@hookform/resolvers": "^3.10.0",
    "@jridgewell/trace-mapping": "^0.3.25",
    "@neondatabase/serverless": "^0.10.4",
    "@prisma/client": "5.22.0",
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-aspect-ratio": "^1.1.3",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-collapsible": "^1.1.4",
    "@radix-ui/react-context-menu": "^2.2.7",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-hover-card": "^1.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-menubar": "^1.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.6",
