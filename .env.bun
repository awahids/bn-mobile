# Bun Runtime Optimizations
BUN_ENV=production
BUN_RUNTIME=bun

# Memory optimizations for Bun
BUN_HEAP_SIZE=4096
BUN_MAX_OLD_SPACE_SIZE=4096

# Performance flags
BUN_ENABLE_LOGGING=false
BUN_DISABLE_TRANSPILER_CACHE=false
BUN_JSC_useJIT=true

# Next.js optimizations with Bun
NEXT_TELEMETRY_DISABLED=1
TURBOPACK=1

# Database connection pooling for better performance
DATABASE_CONNECTION_LIMIT=10
DATABASE_POOL_TIMEOUT=30000

# API optimizations
API_TIMEOUT=30000
API_RETRY_ATTEMPTS=3

# Static asset optimizations
STATIC_CACHE_MAX_AGE=31536000
IMAGE_OPTIMIZATION_ENABLED=true

# Development optimizations
FAST_REFRESH=true
HOT_RELOAD=true